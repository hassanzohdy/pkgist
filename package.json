{
  "name": "@mongez/pkgist",
  "version": "1.6.1",
  "description": "Build, version, and publish tool for TypeScript npm packages. Powered by tsdown.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pkgist": "esm/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "pkgist.config.example.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "release": "pkgist build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.0",
    "ora": "^8.1.0",
    "p-limit": "^5.0.0",
    "semver": "^7.6.0",
    "simple-git": "^3.25.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prettier": "^3.0.0",
    "@types/semver": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
